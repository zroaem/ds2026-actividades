generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Autor {
  id           Int     @id @default(autoincrement())
  nombre       String  @unique
  nacionalidad String?
  libros       Libro[]                     // ← NUEVO: lado "muchos", no crea columna
}

model Libro {
  id         Int         @id @default(autoincrement())
  titulo     String
  mood       String
  imagen     String
  sinopsis   String?
  disponible Boolean     @default(true)
  autorId    Int                                                      
  autor      Autor       @relation(fields: [autorId], references: [id], onDelete: Restrict)
  categorias Categoria[]                                              
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  libros Libro[]
}