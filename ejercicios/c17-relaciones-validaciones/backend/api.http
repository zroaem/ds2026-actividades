@baseUrl = http://localhost:3000

### Hello
GET {{baseUrl}}/

### === LIBROS ===

### Listar libros
GET {{baseUrl}}/api/libros

### Ver un libro
GET {{baseUrl}}/api/libros/1

### Ver un libro que no existe -> 404
GET {{baseUrl}}/api/libros/999

### Crear un libro
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "titulo": "Ficciones",
  "autorId": 1,
  "mood": "Mágico",
  "imagen": "https://picsum.photos/305/400",
  "sinopsis": "Un libro de cuentos."
}

### Modificar un libro
PUT {{baseUrl}}/api/libros/1
Content-Type: application/json

{
  "titulo": "El Aleph (Edición revisada)",
  "autorId": 1,
  "mood": "Mágico",
  "imagen": "https://picsum.photos/300/400",
  "sinopsis": "Nueva sinopsis."
}

### Modificar un libro que no existe -> 404
PUT {{baseUrl}}/api/libros/999
Content-Type: application/json

{
  "titulo": "X",
  "autorId": 1,
  "mood": "X",
  "imagen": "X"
}

### Borrar un libro
DELETE {{baseUrl}}/api/libros/2

### Borrar un libro que no existe -> 404
DELETE {{baseUrl}}/api/libros/999

### 400 - sin título
POST {{baseUrl}}/api/libros
Content-Type: application/json

{ "mood": "Triste", "imagen": "https://picsum.photos/400/400", "autorId": 1 }

### 400 - id inválido
GET {{baseUrl}}/api/libros/abc

### 400 - autorId inexistente (formato válido, dato imposible)
POST {{baseUrl}}/api/libros
Content-Type: application/json

{ "titulo": "Huérfano", "mood": "Confundido", "imagen": "https://picsum.photos/400/400", "autorId": 9999 }

### 409 - autor duplicado
POST {{baseUrl}}/api/autores
Content-Type: application/json

{ "nombre": "Jorge Luis Borges", "nacionalidad": "Argentina" }

### 409 - borrar un autor con libros (onDelete: Restrict)
DELETE {{baseUrl}}/api/autores/1

### 404 - actualizar algo que no existe
PUT {{baseUrl}}/api/libros/9999
Content-Type: application/json

{ "titulo": "No existo" }

### Listar autores
GET {{baseUrl}}/api/autores

### Ver un autor
GET {{baseUrl}}/api/autores/1

### Ver un autor que no existe -> 404
GET {{baseUrl}}/api/autores/999

### Crear un autor
POST {{baseUrl}}/api/autores
Content-Type: application/json

{
  "nombre": "Gabriel García Márquez",
  "nacionalidad": "Colombia"
}

### Modificar un autor
PUT {{baseUrl}}/api/autores/1
Content-Type: application/json

{
  "nombre": "Jorge Luis Borges",
  "nacionalidad": "Argentina"
}

### Modificar un autor que no existe -> 404
PUT {{baseUrl}}/api/autores/999
Content-Type: application/json

{
  "nombre": "X"
}

### Borrar un autor
DELETE {{baseUrl}}/api/autores/3

### Borrar un autor que no existe -> 404
DELETE {{baseUrl}}/api/autores/999