generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Libro {
  id         Int      @id @default(autoincrement())
  titulo     String
  autorId    Int
  mood       String
  imagen     String
  sinopsis   String?
  disponible Boolean  @default(true)
}

model Autor {
  id           Int    @id @default(autoincrement())
  nombre       String @unique
  nacionalidad String?
}